{
  "name": "kantv",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "conformance": "tsx conformance/run.ts",
    "lists:build": "tsx scripts/lists/build.ts",
    "dev:stack": "tsx scripts/dev-stack.ts",
    "dev:api": "tsx --env-file=dev/backend.env packages/backend/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
